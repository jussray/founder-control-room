{
  "contract": "fcr/delegated-agent-authority@v1",
  "repository": "jussray/founder-control-room",
  "activationState": "policy-only",
  "founderDecision": {
    "date": "2026-09-12",
    "standingCapability": true,
    "standingExecutionApproval": false,
    "exactFounderApprovalRequiredPerAction": true,
    "principals": {
      "codex-chat": { "merge_authority": true, "deploy_authority": true },
      "claude": { "merge_authority": true, "deploy_authority": true }
    }
  },
  "sourceEvaluator": {
    "authorizesProviderMutation": false,
    "authorizesCompletionClaim": false,
    "purpose": "policy eligibility only"
  },
  "identity": {
    "requiredForActivation": "server-owned-principal-resolution",
    "callerAssertionIsAuthority": false,
    "callerAttestationBooleanIsAuthority": false
  },
  "review": {
    "requiredForActivation": "provider-backed-independent-review-gate",
    "candidateAuthorMaySatisfyIndependentReview": false,
    "callerReviewBooleanIsAuthority": false
  },
  "founderApproval": {
    "required": true,
    "maxAgeMinutes": 15,
    "mustBind": ["action", "target", "repository", "baseSha", "headSha"],
    "auditableDecisionRefRequired": true,
    "baseOrHeadMovementInvalidatesApproval": true,
    "activationMustUseValidatedFounderDecisionReceipt": true
  },
  "mutationIdentity": {
    "durableReservationRequiredBeforeProviderMutation": true,
    "reservationMustBind": ["action", "target", "baseSha", "headSha"],
    "consumedReservationMayBeReused": false
  },
  "trustedActivationRequirements": [
    "server-owned-principal-resolution",
    "provider-resolved-pr-base-head-author-diff",
    "provider-backed-independent-review-gate",
    "validated-founder-decision-receipt",
    "server-derived-execution-path-capability-classification",
    "current-provider-preflight-receipt",
    "durable-idempotency-reservation",
    "independent-post-action-outcome-verifier"
  ],
  "deployAdditionalRequirements": [
    "head-equals-current-main",
    "environment-production",
    "migration-state-aligned",
    "non-migrating-execution-path",
    "provider-preflight-current"
  ],
  "notDelegated": [
    "database_migration",
    "database_destructive_write",
    "credential_or_secret_mutation",
    "authentication_or_rls_policy_mutation",
    "billing_or_spend",
    "public_publication_or_external_message",
    "dns_or_provider_ownership_mutation",
    "destructive_delete"
  ],
  "truthBoundary": {
    "mergeAuthorityMeansStandingApproval": false,
    "deployAuthorityMeansStandingApproval": false,
    "policyEligibilityMeansExecutionAuthority": false,
    "providerAcceptanceIsOutcomeVerification": false,
    "mergeOrDeployExecutionImpliesVerifiedOutcome": false,
    "postActionIndependentOutcomeEvidenceRequiredForVerifiedClaim": true
  }
}
