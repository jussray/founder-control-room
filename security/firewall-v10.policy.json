{
  "version": "10",
  "name": "Founder Firewall v10",
  "repository": "jussray/founder-control-room",
  "mode": "desired-state-with-observed-app-bindings",
  "activationStage": "policy-ci-only",
  "evidence": {
    "productionCloudflareApplied": "unknown",
    "securityEventsReviewed": "unknown",
    "productionBlockModeAuthorized": false,
    "openApiV3SchemaEvidence": "unknown"
  },
  "cloudflare": {
    "primaryHosts": ["foundercontrolroom.org", "api.foundercontrolroom.org"],
    "managedWaf": {
      "desired": true,
      "planAware": true,
      "productionApplied": "unknown",
      "blockModeAuthorized": false,
      "baseline": "best-available-managed-ruleset-for-plan",
      "upgradeWhenAvailable": ["Cloudflare Managed Ruleset", "OWASP Core Ruleset"]
    },
    "apiShield": {
      "schemaValidation": {
        "desired": true,
        "planAware": true,
        "activationReady": false,
        "productionApplied": "unknown",
        "requiresVerifiedOpenApiV3": true,
        "repositoryOpenApiV3Evidence": "unknown"
      },
      "sessionAuth": {
        "edgeJwtRequired": false,
        "applicationAuthority": "supabase-bearer-or-httponly-founder-cookie-plus-founder_users-allowlist"
      }
    },
    "botDefense": {
      "desired": true,
      "planAware": true,
      "productionApplied": "unknown",
      "zoneWideChallengeAuthorized": false,
      "activationReady": false,
      "requiresMachineClientCompatibilityProof": true,
      "machineClientsToPreserve": [
        "github-webhooks",
        "n8n",
        "mcp",
        "proof-of-ship-receipts",
        "founder-review-email-ingress"
      ]
    },
    "authenticatedOriginPulls": {
      "desiredBeforeDirectOriginExposure": true,
      "productionApplied": "unknown"
    }
  },
  "bindings": {
    "conveyor": {
      "mountPath": "/automation/conveyor",
      "readPath": "/",
      "advancePath": "/advance",
      "fullMutationPath": "/automation/conveyor/advance",
      "founderAuthMiddleware": "requireFounder",
      "sameOriginBrowserMutationGateBeforeMount": true
    }
  },
  "controls": {
    "rateLimiting": {
      "desired": true,
      "productionApplied": "unknown",
      "strategy": "edge-observe-then-enforce-plus-application-baseline",
      "applicationBaseline": {
        "generalPerIp": { "limit": 60, "periodSeconds": 60 },
        "magicLinkPerIp": { "limit": 5, "periodSeconds": 900 }
      },
      "edgeRoutes": [
        {
          "method": "GET",
          "path": "/automation/conveyor/",
          "limit": 60,
          "periodSeconds": 60,
          "enforcement": "observe-before-block"
        },
        {
          "method": "POST",
          "path": "/automation/conveyor/advance",
          "limit": 20,
          "periodSeconds": 60,
          "enforcement": "observe-before-block"
        }
      ]
    },
    "auth": {
      "failClosed": true,
      "privateRoutesRequireServerVerifiedSession": true,
      "founderSessionMethods": ["supabase-bearer", "httponly-founder-session-cookie"],
      "founderAllowlist": "founder_users",
      "edgeJwtRequired": false,
      "forbiddenClientSecrets": true,
      "criticalServerOnlySecrets": ["SUPABASE_SERVICE_ROLE_KEY", "N8N_CONVEYOR_BEARER_TOKEN"]
    },
    "headers": {
      "runtimeObserved": {
        "hstsInProduction": true,
        "referrerPolicy": "no-referrer",
        "xFrameOptions": "SAMEORIGIN"
      },
      "csp": {
        "desired": true,
        "productionApplied": "unknown",
        "activationMode": "report-only-until-surface-proof",
        "surfaceProofRequired": true
      },
      "controlRoomCache": "no-store"
    },
    "integrations": {
      "githubWritesRequireExactHead": true,
      "hubspotWritesRequireExplicitApproval": true,
      "n8nReceiptsRequireIdempotencyKey": true,
      "automationPublishAllowed": false,
      "draftOnlyByDefault": true
    },
    "observability": {
      "securityEventsRequiredBeforeBlockMode": true,
      "logBlockedReason": true,
      "noSilentNulls": true
    },
    "productDesign": {
      "blockedStateMustBeHumanReadable": true,
      "doNotUseCaptchaOnFirstPassWhenChallengeWorks": true,
      "legitimateUsersGetRecoveryPath": true,
      "noMisleadingConnectedOrProtectedClaims": true
    }
  }
}
