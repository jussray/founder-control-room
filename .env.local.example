# Optional local overrides for Founder Control Room development.
# Start from .env.example and copy only the names you need into .env.local.
# Never place real credentials in this committed template.

# Founder Control Room Supabase project
SUPABASE_URL=https://oojzfmmywbvficgybaxd.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub webhook HMAC verification
GITHUB_WEBHOOK_SECRET=

# Local browser/API origins
FOUNDER_API_URL=http://localhost:8787
FOUNDER_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:3000

# Cloudflare Worker production secrets are installed in the Worker secret store,
# not copied into this local template. See .env.example and docs/SECRETS.md.
