{
  "name": "founder-control-room",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:design-os": "tsc -p tsconfig.design-os.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "whoami": "python3 scripts/whoami.py",
    "verify:whoami": "python3 -m unittest scripts/test_whoami.py",
    "cf:dev": "wrangler dev --config wrangler.toml --port 8787",
    "cf:dev:api": "wrangler dev --config wrangler.api.toml --port 8788",
    "cf:dry-run": "wrangler deploy --dry-run --config wrangler.toml --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy --config wrangler.toml",
    "deploy:api": "wrangler deploy --config wrangler.api.toml",
    "lint": "eslint 'src/**/*.ts'",
    "lint:design-os": "eslint 'src/design-os/**/*.ts' 'src/http/routes/designOs.ts' 'src/http/routes/designOs.test.ts' --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "npm run build && node e2e/run.mjs",
    "setup:test-browser": "playwright install chromium",
    "verify:parallel": "node scripts/verify-parallel.mjs",
    "preview:evidence": "node scripts/import-preview-evidence.mjs",
    "verify:capability-contract": "node scripts/verify-capability-contract.mjs",
    "verify:mcp": "node scripts/verify-mcp-config.mjs",
    "verify:terminal-contract": "node scripts/verify-guarded-terminal-contract.mjs",
    "verify:ai-skills": "node scripts/verify-ai-skill-contract.mjs && node scripts/verify-mirror-and-fact-check-contract.mjs && node scripts/verify-founder-intelligence-inheritance.mjs && node scripts/verify-agent-fleet-skills.mjs && node scripts/verify-zapier-task-budget.mjs && node tools/zapier/test-buffer-content-firewall.cjs && node tools/zapier/test-buffer-provider-contract.cjs",
    "verify:zapier-budget": "node scripts/verify-zapier-task-budget.mjs && node tools/zapier/test-buffer-content-firewall.cjs && node tools/zapier/test-buffer-provider-contract.cjs",
    "verify:buffer-content": "node tools/zapier/test-buffer-content-firewall.cjs && node tools/zapier/test-buffer-provider-contract.cjs",
    "verify:buffer-provider": "node tools/zapier/test-buffer-provider-contract.cjs",
    "verify:ai-company-parity": "node scripts/verify-founder-os-lab-isolation.mjs && npm --prefix labs/ai-company run verify && vitest run --config vitest.ai-company-parity.config.ts",
    "verify:ai-company-adversarial": "node scripts/verify-founder-os-lab-isolation.mjs && npm --prefix labs/ai-company run verify && vitest run --config vitest.ai-company-adversarial.config.ts",
    "verify:founder-chief-pair": "node scripts/verify-founder-chief-pair.mjs",
    "verify:cookies": "node scripts/verify-cookie-contract.mjs",
    "verify:founder-onboarding": "node scripts/verify-founder-onboarding.mjs",
    "verify:growth-inbox": "node scripts/verify-unified-growth-inbox.mjs",
    "verify:design-os": "node scripts/verify-design-os-contract.mjs && vitest run --config vitest.design-os.config.ts",
    "verify:local-workspace": "node scripts/verify-local-workspace.mjs",
    "verify:rls-contract": "node scripts/verify-rls-contract.mjs",
    "verify:futureyou-v8": "node scripts/verify-futureyou-v8.mjs && vitest run src/futureyou/missionControl.test.ts src/http/routes/__tests__/futureYou.integration.test.ts",
    "verify:goalfix": "vitest run src/goalfix/__tests__/engine.test.ts src/http/routes/__tests__/goalfix.integration.test.ts",
    "verify:mirror": "vitest run src/http/routes/__tests__/mirror.integration.test.ts",
    "verify:mirror-contract": "node scripts/verify-mirror-and-fact-check-contract.mjs",
    "proof:goalfix": "npm run build && node e2e/goalfix-proof.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.2",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "@playwright/test": "^1.45.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.61.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "wait-on": "^7.2.0",
    "wrangler": "^4.110.0"
  },
  "engines": {
    "node": ">=20"
  }
}
