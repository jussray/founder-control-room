# RepositoryProvider (GitHub, Phase 1)
# Production authority: repository-scoped GitHub App installation tokens.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Local/development fallback only. Do not make a personal token authoritative.
GITHUB_TOKEN=

# Optional signed repo-runner pings. Prefer a distinct secret per repository:
# REPOSITORY_INGEST_SECRET_SEKRET_BIP=
# REPOSITORY_INGEST_SECRET_FOUNDER_CONTROL_ROOM=
REPOSITORY_INGEST_SECRET=

# This project's OWN Supabase project — never a product project's database.
# Runtime identity is code-locked to project ref oojzfmmywbvficgybaxd.
SUPABASE_URL=https://oojzfmmywbvficgybaxd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Local Supabase emulator only. This is rejected in production even when true.
SUPABASE_ALLOW_LOCAL=false

# Local/admin Postgres smoke test only. Never expose this in frontend code.
# Percent-encode the password if it contains special characters.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_FOUNDER_CONTROL_ROOM_PROJECT.supabase.co:5432/postgres?sslmode=require

# Publishable key used only for founder magic-link/session auth.
SUPABASE_PUBLISHABLE_KEY=

# Founder allowlist bootstrap/operations. Use your own founder email locally.
FOUNDER_EMAIL=founder@example.com

# Required server-only key for encrypting Supabase credentials stored behind the
# opaque HttpOnly founder session. Generate exactly 32 random bytes and encode
# as unpadded base64url. Never expose this value to Pages or browser code.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
FOUNDER_SESSION_ENCRYPTION_KEY=

# QuickScan Stripe Payment Link webhook (payment verification only).
# FCR stores a founder-pasted Stripe Payment Link and consumes verified
# payment status; it never calls the Stripe API to create checkout, so no
# Stripe API/secret key is required here — only the webhook signing secret
# for the Stripe endpoint pointed at POST /webhooks/stripe-quickscan,
# listening for checkout.session.completed.
STRIPE_QUICKSCAN_WEBHOOK_SECRET=

# Optional hardening: the canonical QuickScan Payment Link's id (starts with
# plink_), found on the Payment Link in the Stripe Dashboard. When set, a
# webhook event is only trusted as this prospect's payment if the checkout
# session's own payment_link field matches — otherwise a same-price checkout
# completed on an unrelated Stripe product could also satisfy the amount and
# currency check. Safe to leave unset; the amount/currency check still runs.
STRIPE_QUICKSCAN_PAYMENT_LINK_ID=

# HTTP server
PORT=8787
NODE_ENV=development

# Guarded terminal — disabled and loopback-only by default.
CONTROL_ROOM_TERMINAL_ENABLED=false
CONTROL_ROOM_TERMINAL_ALLOW_REMOTE=false
CONTROL_ROOM_WORKSPACE_ROOT=

# MCP Hub — endpoint values and bearer tokens stay local/secret.
MCP_REQUEST_TIMEOUT_MS=10000
MCP_GITHUB_URL=
MCP_GITHUB_TOKEN=
MCP_EXA_URL=https://mcp.exa.ai/mcp
MCP_RESEND_URL=https://mcp.resend.com/mcp
MCP_PLAYWRIGHT_URL=
MCP_PLAYWRIGHT_TOKEN=
MCP_FIGMA_URL=
MCP_FIGMA_TOKEN=
MCP_SUPABASE_DEV_URL=
MCP_SUPABASE_DEV_TOKEN=

# Served remote read-only MCP gateway (`POST /mcp/read`). Keep this token
# distinct from every write-capable MCP token. Project scope is server-held;
# callers cannot widen it. The grant covers every current active FCR portfolio
# project and deliberately excludes external continuity-only/quarantined repos.
FCR_REMOTE_MCP_READ_TOKEN=
FCR_REMOTE_MCP_READ_PROJECTS=sekret-bip,juss-beautiful-hair,juss-beautiful-hair-private,l99,chief-ai-machine,untold-stories,founder-control-room,promptos

# Official Cloudflare API MCP authority. The in-app Hub permits schema search
# only; generic Code Mode execute remains denied. A separately scoped diagnostic
# may use the dedicated read token for one fixed GET-only provider witness.
MCP_CLOUDFLARE_API_URL=https://mcp.cloudflare.com/mcp
FCR_CLOUDFLARE_MCP_READ_TOKEN=

# External FCR MCP. The canonical /mcp route uses Supabase OAuth; /mcp/read is
# a temporary static-token compatibility lane whose token/scope names are
# declared once above. OAuth access tokens must carry the configured audience,
# mcp:read scope, client_id, and an mcp_projects array. The server intersects
# that claim with the active-portfolio allowlist. No cookie or fingerprint is
# used for MCP identity.
FCR_REMOTE_MCP_RESOURCE=https://api.foundercontrolroom.org/mcp
FCR_REMOTE_MCP_OAUTH_ISSUER=https://oojzfmmywbvficgybaxd.supabase.co/auth/v1
FCR_REMOTE_MCP_OAUTH_AUDIENCE=
FCR_REMOTE_MCP_OAUTH_CLIENT_IDS=
FCR_REMOTE_MCP_OAUTH_REQUIRED_SCOPE=mcp:read
FCR_REMOTE_MCP_ALLOWED_ORIGINS=
CHIEF_AI_BASE_URL=

# Founder-only Mirror Engine. This is a direct backend provider credential,
# separate from the existing Zapier connection key reference below.
OPENAI_API_KEY=
MIRROR_ENGINE_MODEL=
MIRROR_ENGINE_TIMEOUT_MS=25000
OPENAI_API_BASE_URL=https://api.openai.com/v1

# QuickScan Chief next-action reasoning. Shares OPENAI_API_KEY and
# OPENAI_API_BASE_URL above with Mirror Engine — a second consumer of the
# same credential, not a separate key. Founder-triggered only (no automatic
# calls); reasons from a prospect's own recorded evidence/segment/
# qualification only. Both optional overrides:
QUICKSCAN_CHIEF_MODEL=
QUICKSCAN_CHIEF_TIMEOUT_MS=25000

# External code-use hourly digest.
RESEND_API_KEY=
EXTERNAL_USE_EMAIL_FROM=

# Founder Signal Engine remote MCP bridge.
# These values belong in the surviving founder-control-room Worker secret
# store, never in Pages, GitHub issues, chat, screenshots, logs, or public proof.
# Generate a distinct MCP bearer token. This is NOT the OpenAI API key.
FOUNDER_SIGNAL_ENGINE_MCP_TOKEN=
# The private Zapier Catch Hook URL for the named Founder Signal Engine workflow.
ZAPIER_FOUNDER_SIGNAL_ENGINE_HOOK_URL=
# Server-held JSON grant for exact standing-policy routes.
FOUNDER_SIGNAL_AUTOMATION_GRANT_JSON=
# Optional timeout in milliseconds. Allowed range: 500-60000.
FOUNDER_SIGNAL_ENGINE_HOOK_TIMEOUT_MS=10000

# Read-only Founder Signal evidence MCP.
# Use a DIFFERENT random bearer token from FOUNDER_SIGNAL_ENGINE_MCP_TOKEN so
# ChatGPT/Claude/read-only workbenches cannot inherit write-bridge capability.
FOUNDER_SIGNAL_READ_MCP_TOKEN=

# Portfolio X engagement observation. Source is mock-first and live-disabled by
# default. A live provider call requires all three values plus separately
# authorized provider account/billing and the portfolio-signal DB migration.
X_ENGAGEMENT_LIVE_ENABLED=false
APIFY_TOKEN=
# Explicit per-run provider cap. Code rejects values above 0.10 USD.
X_ENGAGEMENT_MAX_CHARGE_USD=

# Machine build-event receipt ingress.
# This is a separate credential root from FOUNDER_SIGNAL_ENGINE_MCP_TOKEN.
# FCR derives purpose-scoped producer credentials from this root; never reuse
# the remote MCP bearer here or expose this root to producer clients.
FCR_BUILD_EVENT_RECEIPT_ROOT_TOKEN=

# Founder review-email intake.
# Install the same strong random secret in the surviving founder-control-room
# API Worker and the separate founder-control-room-review-email Worker.
FOUNDER_REVIEW_EMAIL_INGRESS_SECRET=
FOUNDER_REVIEW_FOUNDER_EMAIL=
FOUNDER_REVIEW_EMAIL_DOMAIN=foundercontrolroom.org
FOUNDER_REVIEW_INGEST_URL=https://api.foundercontrolroom.org/ingest/founder-review-email

# Existing provider-held OpenAI key reference used by the caller/Zapier connection:
#   zapier-founder-signal-engine
# Do not paste the raw key here. Do not recreate, rotate, or duplicate it merely
# because ChatGPT lacks a native Zapier connector.

# ---------------------------------------------------------------------------
# URL SETTINGS
# ---------------------------------------------------------------------------
#
# Production topology:
#   Cloudflare Pages: https://foundercontrolroom.org
#   API Worker:       https://api.foundercontrolroom.org
#
# Browser requests remain same-origin because public/_worker.js serves static
# assets first and forwards missing or mutating requests to the API Worker.
#
# FOUNDER_API_URL
#   The founder-facing callback origin. In production this is the Pages origin:
#     FOUNDER_API_URL=https://foundercontrolroom.org
#   Supabase returns to /auth/callback on Pages, Pages forwards that route to the
#   API Worker, and the Worker's relative /control-room/ redirect lands back on
#   the frontend origin.
#
# FOUNDER_ALLOWED_ORIGINS
#   Comma-separated browser origins allowed by the API. Production uses:
#     FOUNDER_ALLOWED_ORIGINS=https://foundercontrolroom.org
#
# Both are required in production. Defaults below are for local development.
# ---------------------------------------------------------------------------
FOUNDER_API_URL=http://localhost:8787
FOUNDER_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:3000
