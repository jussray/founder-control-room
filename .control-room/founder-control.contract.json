{
  "schemaVersion": "1.0",
  "contract": "juss-v10/founder-control-decision@v1",
  "status": "active",
  "canonicalAuthority": {
    "repository": "jussray/founder-control-room",
    "rule": "founder-explicit-exact-proposal-only"
  },
  "founderSurfaces": [
    "fcr",
    "chatgpt",
    "claude",
    "perplexity"
  ],
  "orchestrationPlanes": [
    "n8n",
    "zapier"
  ],
  "rules": {
    "surfaceMaySelfAuthorize": false,
    "chiefMaySelfAuthorize": false,
    "silenceIsApproval": false,
    "proposalMutationInvalidatesApproval": true,
    "executionRequiresExactProposalBinding": true,
    "executionReceiptRequired": true,
    "providerSuccessIsOutcomeProof": false
  },
  "branchLifecycle": {
    "classifications": [
      "stale",
      "superseded",
      "retirable"
    ],
    "rules": {
      "staleDoesNotImplySuperseded": true,
      "staleDoesNotImplyRetirable": true,
      "retirementRequiresUniqueWorkInventory": true,
      "retirementRequiresInventoryEvidence": true,
      "inventoryCoverageMustBeComplete": true,
      "inventoryCoverageMustBeSingleDisposition": true,
      "retirementRequiresDispositionForEveryUniqueSlice": true,
      "retirementRequiresZeroUnclassifiedResidual": true,
      "unknownResidualBlocksRetirement": true,
      "unresolvedReviewFindingsBlockRetirement": true,
      "carriedForwardRequiresProviderVerifiedDestination": true,
      "carriedForwardDestinationRequiresExactHead": true,
      "directBranchDeletionExposed": false,
      "branchDeletionRequiresReceiptAwareReconciler": true
    },
    "inventorySource": "provider-compare",
    "destinationEvidenceSource": "provider-readback",
    "allowedDispositions": [
      "integrated",
      "superseded",
      "carried-forward",
      "intentionally-discarded"
    ],
    "requiredRetirementReceiptFields": [
      "repository",
      "branch",
      "headSha",
      "mergeBaseSha",
      "currentMainSha",
      "inventoryEvidence",
      "uniqueSlices",
      "unresolvedReviewFindings",
      "residualUniqueWork",
      "safeToClose",
      "safeToDeleteBranch"
    ]
  }
}
