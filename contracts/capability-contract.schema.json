{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://founder-control-room.local/contracts/capability-contract.v1.schema.json",
  "title": "Portfolio Capability Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "name", "repository", "mission", "capabilities", "verification", "health", "proof", "deployment", "rollback", "dependencies", "security", "telemetry", "last_verified", "blockers", "next_gate"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "mission": {"type": "string", "minLength": 1},
    "owner": {"type": "string"},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "description"],
        "properties": {
          "id": {"enum": ["BUILD", "TEST", "VERIFY", "DEPLOY", "ROLLBACK", "HEALTH", "AUTH", "DATABASE", "API", "AI", "MCP", "AUTOMATION", "CRM", "ANALYTICS", "NOTIFICATIONS", "OBSERVABILITY", "SECURITY", "EVIDENCE"]},
          "status": {"enum": ["verified", "partial", "unverified", "blocked", "not_applicable"]},
          "description": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}, "default": []}
        }
      }
    },
    "verification": {"type": "array", "items": {"type": "object", "required": ["name", "command"], "properties": {"name": {"type": "string"}, "command": {"type": "string"}, "required": {"type": "boolean", "default": true}}, "additionalProperties": false},
    "health": {"type": "object", "required": ["overall", "build", "tests", "deploy", "runtime", "proof"], "properties": {"overall": {"enum": ["green", "yellow", "red", "unknown"]}, "build": {"enum": ["green", "yellow", "red", "unknown"]}, "tests": {"enum": ["green", "yellow", "red", "unknown"]}, "deploy": {"enum": ["green", "yellow", "red", "unknown"]}, "runtime": {"enum": ["green", "yellow", "red", "unknown"]}, "proof": {"enum": ["green", "yellow", "red", "unknown"]}}, "additionalProperties": false},
    "proof": {"type": "array", "items": {"type": "object", "required": ["claim", "status", "artifact"], "properties": {"claim": {"type": "string"}, "status": {"enum": ["verified", "partial", "unverified", "expired"]}, "artifact": {"type": "string"}, "commit": {"type": "string"}, "verified_at": {"type": ["string", "null"], "format": "date-time"}}, "additionalProperties": false},
    "deployment": {"type": "object"},
    "rollback": {"type": "object"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "security": {"type": "object"},
    "telemetry": {"type": "object"},
    "last_verified": {"type": ["string", "null"], "format": "date-time"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "next_gate": {"type": "string"}
  }
}
