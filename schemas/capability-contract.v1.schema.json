{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://founder-control-room.local/schemas/capability-contract.v1.schema.json",
  "title": "Capability Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "mission",
    "repository",
    "capabilities",
    "verification",
    "health",
    "proof",
    "rollback",
    "dependencies",
    "last_verified",
    "blockers",
    "next_gate"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "mission": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["BUILD", "TEST", "VERIFY", "DEPLOY", "ROLLBACK", "HEALTH", "AUTH", "DATABASE", "API", "AI", "MCP", "AUTOMATION", "CRM", "ANALYTICS", "NOTIFICATIONS", "OBSERVABILITY", "SECURITY", "EVIDENCE"]
          },
          "status": { "type": "string", "enum": ["verified", "partial", "unverified", "blocked", "not_applicable"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
          "notes": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "purpose"],
        "properties": {
          "id": { "type": "string" },
          "command": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "build", "tests", "deploy", "runtime", "proof"],
      "properties": {
        "overall": { "$ref": "#/$defs/healthState" },
        "build": { "$ref": "#/$defs/healthState" },
        "tests": { "$ref": "#/$defs/healthState" },
        "deploy": { "$ref": "#/$defs/healthState" },
        "runtime": { "$ref": "#/$defs/healthState" },
        "proof": { "$ref": "#/$defs/healthState" }
      }
    },
    "proof": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status", "source"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["workflow", "artifact", "commit", "deployment", "test_report", "runtime_check", "manual_review"] },
          "status": { "type": "string", "enum": ["verified", "stale", "missing", "failed"] },
          "source": { "type": "string" },
          "sha256": { "type": "string" },
          "verified_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string" },
        "environment": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verified"],
      "properties": {
        "method": { "type": "string" },
        "verified": { "type": "boolean" },
        "evidence_id": { "type": ["string", "null"] }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "security": { "type": "array", "items": { "type": "string" } },
    "telemetry": { "type": "array", "items": { "type": "string" } },
    "last_verified": { "type": ["string", "null"], "format": "date-time" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "next_gate": { "type": "string" }
  },
  "$defs": {
    "healthState": {
      "type": "string",
      "enum": ["green", "yellow", "red", "unknown", "not_applicable"]
    }
  }
}
