{
  "schema": "fcr/worker-capability-secrets@v1",
  "startupAuthority": "wrangler.worker.toml [secrets].required",
  "semantics": {
    "startupRequired": "missing binding blocks Worker promotion/startup",
    "capabilityOptional": "missing binding disables only the owning capability and must fail closed at use"
  },
  "capabilityOptional": [
    {
      "name": "FCR_REMOTE_MCP_READ_TOKEN",
      "capability": "remote-mcp-read-compat"
    },
    {
      "name": "FCR_SHOPIFY_WEBHOOK_SECRET",
      "capability": "shopify-commerce-ingress"
    },
    {
      "name": "FCR_COMMERCE_HASH_SALT",
      "capability": "shopify-commerce-ingress"
    },
    {
      "name": "TINYFISH_API_KEY",
      "capability": "tinyfish-web-observation-v1"
    },
    {
      "name": "FCR_CLOUDFLARE_MCP_READ_TOKEN",
      "capability": "cloudflare-mcp-read-proof"
    },
    {
      "name": "MODEL_API_KEY",
      "capability": "council-muse-relay"
    },
    {
      "name": "FOUNDER_SIGNAL_ENGINE_MCP_TOKEN",
      "capability": "founder-signal-engine-mcp"
    },
    {
      "name": "ZAPIER_FOUNDER_SIGNAL_ENGINE_HOOK_URL",
      "capability": "founder-signal-engine-zapier"
    },
    {
      "name": "FOUNDER_REVIEW_EMAIL_INGRESS_SECRET",
      "capability": "founder-review-email-ingress"
    },
    {
      "name": "N8N_FOUNDER_CONTENT_WEBHOOK_URL",
      "capability": "founder-content-n8n"
    },
    {
      "name": "N8N_FOUNDER_CONTENT_BEARER_TOKEN",
      "capability": "founder-content-n8n"
    },
    {
      "name": "N8N_FOUNDER_CONTENT_EXPECTED_WORKFLOW_FINGERPRINT",
      "capability": "founder-content-n8n"
    },
    {
      "name": "N8N_FOUNDER_CONTENT_IDENTITY_HMAC_SECRET",
      "capability": "founder-content-n8n"
    }
  ]
}
