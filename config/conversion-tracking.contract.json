      "serviceContext": "laundry",
      "redirectRoutes": {
        "call_click": "/pappa/call",
        "whatsapp_click": "/pappa/whatsapp",
        "pickup_request": "/pappa/pickup",
        "directions_click": "/pappa/directions"
      },
      "allowedPagePaths": [
        "/",
        "/contact",
        "/services",
        "/pickup",
        "/directions"
      ],
      "eventCtaLocations": {
        "call_click": "primary_call",
        "whatsapp_click": "primary_whatsapp",
        "pickup_request": "pickup_cta",
        "directions_click": "find_us"
