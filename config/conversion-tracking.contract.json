{
  "schemaVersion": 1,
  "authority": "fcr/portfolio-conversion-tracking@v1",
  "eventNames": [
    "call_click",
    "whatsapp_click",
    "pickup_request",
    "directions_click"
  ],
  "allowedPayloadFields": [
    "project",
    "event_name",
    "page_path",
    "cta_location",
    "service_context",
    "occurred_at"
  ],
  "forbiddenPayloadFields": [
    "email",
    "phone",
    "phone_number",
    "message",
    "message_text",
    "whatsapp_message",
    "ip",
    "ip_address",
    "user_agent",
    "cookie",
    "device_id",
    "browser_fingerprint",
    "user_id"
  ],
  "storage": {
    "provider": "cloudflare-d1",
    "workerName": "jussco-conversions",
    "databaseName": "jussco-conversions",
    "databaseId": "3b77c3d5-4068-4597-9d97-96009d339e73",
    "bindingName": "DB"
  },
  "retention": {
    "automaticDeletionEnabled": false,
    "deletionRequiresExplicitFounderApproval": true
  },
  "projects": {
    "pappa-razzy-laundry": {
