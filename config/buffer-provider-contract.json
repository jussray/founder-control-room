{
  "version": 3,
  "status": "draft-only-source-enforced-awaiting-live-drafts-proof",
  "provider": "buffer",
  "zapier": {
    "action": "buffer_add_to_queue",
    "requiredMethod": "draft",
    "allowedMethods": [
      "draft"
    ],
    "rejectedMethods": [
      "queue",
      "schedule",
      "publish",
      "share_next",
      "share_now",
      "schedule_draft"
    ],
    "mappingComment": "method: draft # required; never rely on Buffer default"
  },
  "api": {
    "mutation": "createPost",
    "required": {
      "sharingMode": "addToQueue",
      "dueAtSource": null,
      "saveToDraft": true
    }
  },
  "reviewWindow": {
    "minutes": 0,
    "startsFrom": "generated_at",
    "generatedAtMaximumAgeMinutes": 5,
    "fireTimeOwnedByFirewall": false,
    "noReplyBehavior": "remain_draft_until_explicit_founder_action",
    "shareNowAllowed": false
  },
  "notification": {
    "provider": "gmail",
    "required": false,
    "mode": "optional_review_digest",
    "requiredFields": [
      "caption",
      "channel",
      "buffer_post_id",
      "review_token",
      "reply_context_id",
      "founder_sender",
      "reply_to",
      "gmail_thread_id"
    ],
    "failurePolicy": "retain_draft",
    "replyCommands": [
      "cancel all",
      "<channel>: cancel",
      "<channel>: <requested tweak>"
    ],
    "replyAuthorizationFields": [
      "founder_sender",
      "reply_to",
      "reply_context_id",
      "review_token"
    ],
    "evidenceOnlyFields": [
      "gmail_thread_id"
    ],
    "replyIdentityPolicy": "exact_founder_sender_private_recipient_and_uuid_review_context",
    "replyParsingPolicy": "exactly_one_unquoted_command_on_first_nonempty_line",
    "ambiguousReplyPolicy": "reject_multiple_unquoted_command_lines",
    "editPolicy": "regenerate_and_revalidate_before_buffer_update",
    "replyIngress": {
      "requiredLatencyClass": "not_required_for_draft_only",
      "gmailPollingAllowed": false,
      "preferredImplementation": "buffer_drafts_human_review",
      "replyToMode": "optional_private_review_context",
      "reason": "draft-only mode has no automatic publication deadline"
    }
  },
  "authority": {
    "publishAllowed": false,
    "schedulePolicyId": "buffer-draft-review-v1",
    "requiredAuthorizationMode": "standing-policy",
    "requiresRuntimeMintedReceipt": true,
    "receiptFormat": "standing-policy:<grantId>:<invocationId>",
    "receiptPurpose": "exact runtime correlation",
    "securityBoundary": "authenticated Founder Control Room middleware plus private provider ingress",
    "maximumGrantIdLength": 100,
    "maximumReceiptLength": 200,
    "requiresExactSourceCommit": true,
    "requiresHttpsProof": true,
    "liveProviderMutationIncluded": false
  },
  "attackTen": {
    "version": 1,
    "status": "implemented-awaiting-controlled-live-proof",
    "scope": "advisory-evidence-only",
    "standaloneEvaluatorAuthorizesProduction": false,
    "requiresAuthoritativeProductionAdapter": true,
    "releaseState": "VERIFIED_PUBLISHED",
    "verifiedLeverageCountState": "VERIFIED_PUBLISHED",
    "assertions": [
      { "id": "A1", "name": "founder_approval_claim_correlated_advisory_only" },
      { "id": "A2", "name": "authority_consumption_claim_correlated_advisory_only" },
      { "id": "A3", "name": "review_window_twenty_minute_duration_enforced" },
      { "id": "A4", "name": "actual_canonical_payload_hashed_and_correlated" },
      { "id": "A5", "name": "provider_capability_claim_correlated_advisory_only" },
      { "id": "A6", "name": "derived_idempotency_and_reservation_claim_correlated" },
      { "id": "A7", "name": "provider_readback_claim_linkedin_correlated" },
      { "id": "A8", "name": "ingress_verification_claim_correlated_replay_bounded" },
      { "id": "A9", "name": "runtime_claim_linkedin_correlated" },
      { "id": "A10", "name": "current_exact_evidence_history_and_red_states_safe" }
    ],
    "identityBindings": [
      "publication_run_id",
      "canonical_payload_artifact",
      "canonical_payload_sha256",
      "founder_approval_id",
      "founder_approval_store_readback",
      "review_generated_at",
      "review_matured_at",
      "authority_id",
      "authority_nonce",
      "authority_consumed_at",
      "execution_reservation_id",
      "provider_action_id",
      "provider_post_id",
      "ingress_publication_run_id",
      "ingress_authority_id",
      "ingress_content_sha256",
      "ingress_provider_action_id",
      "ingress_signer_id",
      "ingress_signature_evidence_ref",
      "runtime_post_id",
      "runtime_url",
      "event_occurred_at"
    ],
    "eventLedger": {
      "appendOnly": true,
      "hashChained": true,
      "deriveCurrentStateFromHistory": true,
      "stateOverwriteAllowed": false,
      "exactEvidenceRefBindingRequired": true,
      "futureDatedEvidenceRejected": true,
      "ingressInvalidReachableFromProcessingStates": true,
      "missingEvidenceState": "UNKNOWN"
    },
    "negativeControls": [
      "caller_approval_not_authoritative_rejected",
      "premature_execution_denied",
      "short_review_window_rejected",
      "expired_authority_rejected",
      "unconsumed_terminal_authority_rejected",
      "replayed_nonce_blocked",
      "canonical_payload_mutation_rejected",
      "mismatched_content_rejected",
      "arbitrary_idempotency_rejected",
      "missing_persisted_reservation_rejected",
      "cross_run_ingress_substitution_rejected",
      "caller_declared_ingress_signer_trust_rejected",
      "missing_server_verifier_or_ledger_evidence_rejected",
      "missing_ingress_signer_policy_rejected",
      "stale_ingress_replay_rejected",
      "wrong_destination_rejected",
      "mismatched_ledger_evidence_rejected",
      "future_dated_event_rejected"
    ],
    "redStates": [
      "DENIED",
      "EXPIRED",
      "REVOKED",
      "FAILED",
      "UNKNOWN",
      "CORRELATION_FAILED",
      "INGRESS_INVALID",
      "DUPLICATE_BLOCKED",
      "ROLLBACK_PENDING",
      "ROLLED_BACK"
    ],
    "releaseGate": {
      "standaloneEvaluatorAuthorizesProduction": false,
      "requiresAuthoritativeProductionAdapter": true,
      "requiresLiveProviderMutation": true,
      "requiresControlledSyntheticRun": true,
      "controlledSyntheticRunPurpose": "advisory-classifier-proof-only",
      "requiresActualCanonicalPayloadHash": true,
      "requiresReviewWindowDurationMs": 1200000,
      "rejectsFutureDatedEvidence": true,
      "requiresExactReceiptCorrelation": true,
      "requiresExactEvidenceRefBinding": true,
      "requiresVerifiedIngressCapability": true,
      "requiresAuthenticatedIngress": true,
      "requiresSignatureVerification": true,
      "requiresIngressEvidenceChainCorrelation": true,
      "requiresServerOwnedIngressSignerAllowlist": true,
      "requiresBoundedIngressReplayWindow": true,
      "requiresConsumedOneUseAuthorityEvidence": true,
      "requiresLiveProviderCapability": true,
      "requiresCurrentContentHashMatch": true,
      "requiresRuntimeOutcomeObservation": true
    }
  },
  "activationGates": {
    "requiredSecrets": [
      "FOUNDER_SIGNAL_ENGINE_MCP_TOKEN",
      "ZAPIER_FOUNDER_SIGNAL_ENGINE_HOOK_URL",
      "FOUNDER_SIGNAL_AUTOMATION_GRANT_JSON"
    ],
    "requiredCapabilities": [
      "webhook_trigger",
      "multi_step_workflow_or_backend_orchestration"
    ],
    "freeTwoStepZapAloneSufficient": false,
    "gmailPollingTriggerAcceptedForDeadlineCommands": false,
    "controlledSyntheticRunRequired": true,
    "exactReceiptCorrelationRequired": true
  }
}
