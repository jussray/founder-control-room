{
  "version": 2,
  "status": "implemented-awaiting-live-provider-and-ingress-proof",
  "provider": "buffer",
  "zapier": {
    "action": "buffer_add_to_queue",
    "requiredMethod": "schedule",
    "allowedMethods": [
      "schedule"
    ],
    "rejectedMethods": [
      "draft",
      "queue",
      "publish",
      "share_next",
      "share_now",
      "schedule_draft"
    ],
    "mappingComment": "method: schedule # exact live option and date-field mapping must be captured in the controlled Zap proof"
  },
  "api": {
    "mutation": "createPost",
    "required": {
      "sharingMode": "customScheduled",
      "dueAtSource": "scheduled_at",
      "saveToDraft": false
    }
  },
  "reviewWindow": {
    "minutes": 20,
    "startsFrom": "generated_at",
    "generatedAtMaximumAgeMinutes": 5,
    "fireTimeOwnedByFirewall": true,
    "noReplyBehavior": "publish_by_existing_buffer_schedule",
    "shareNowAllowed": false
  },
  "notification": {
    "provider": "gmail",
    "required": true,
    "mode": "one_campaign_digest_for_up_to_three_posts",
    "requiredFields": [
      "caption",
      "channel",
      "fire_time",
      "buffer_post_id",
      "review_token",
      "reply_context_id",
      "founder_sender",
      "reply_to",
      "gmail_thread_id"
    ],
    "failurePolicy": "cancel_scheduled_batch",
    "replyCommands": [
      "cancel all",
      "<channel>: cancel",
      "<channel>: <requested tweak>"
    ],
    "replyAuthorizationFields": [
      "founder_sender",
      "reply_to",
      "reply_context_id",
      "review_token",
      "review_deadline"
    ],
    "evidenceOnlyFields": [
      "gmail_thread_id"
    ],
    "replyIdentityPolicy": "exact_founder_sender_private_recipient_and_uuid_review_context",
    "replyParsingPolicy": "exactly_one_unquoted_command_on_first_nonempty_line",
    "quotedHistoryPolicy": "ignore_only_after_valid_command_boundary",
    "ambiguousReplyPolicy": "reject_multiple_unquoted_command_lines",
    "editPolicy": "regenerate_and_revalidate_before_buffer_update",
    "replyIngress": {
      "requiredLatencyClass": "instant_private_ingress",
      "gmailPollingAllowed": false,
      "preferredImplementation": "cloudflare_email_routing_worker",
      "replyToMode": "private_domain_address_bound_to_uuid_review_context",
      "reason": "a 15-minute polling trigger cannot reliably honor commands throughout a 20-minute review window"
    }
  },
  "authority": {
    "publishAllowed": true,
    "schedulePolicyId": "buffer-20-minute-review-v1",
    "requiredAuthorizationMode": "standing-policy",
    "requiresRuntimeMintedReceipt": true,
    "receiptFormat": "standing-policy:<grantId>:<invocationId>",
    "receiptPurpose": "exact runtime correlation",
    "securityBoundary": "authenticated Founder Control Room middleware plus private provider ingress",
    "maximumGrantIdLength": 100,
    "maximumReceiptLength": 200,
    "requiresExactSourceCommit": true,
    "requiresHttpsProof": true,
    "liveProviderMutationIncluded": false
  },
  "attackTen": {
    "version": 1,
    "status": "implemented-awaiting-controlled-live-proof",
    "releaseState": "VERIFIED_PUBLISHED",
    "verifiedLeverageCountState": "VERIFIED_PUBLISHED",
    "assertions": [
      { "id": "A1", "name": "founder_intent_immutable" },
      { "id": "A2", "name": "authority_scoped_expiring_one_use_non_transferable" },
      { "id": "A3", "name": "review_window_control_plane_enforced" },
      { "id": "A4", "name": "content_identity_frozen_integrity_bound" },
      { "id": "A5", "name": "provider_capability_live_policy_gated" },
      { "id": "A6", "name": "execution_idempotent_receipt_correlated" },
      { "id": "A7", "name": "provider_acknowledgement_independently_read_back" },
      { "id": "A8", "name": "ingress_authenticated_deduplicated_durable" },
      { "id": "A9", "name": "runtime_outcome_observed" },
      { "id": "A10", "name": "red_states_and_rollback_visible_safe" }
    ],
    "identityBindings": [
      "publication_run_id",
      "canonical_payload_sha256",
      "founder_approval_id",
      "authority_id",
      "authority_nonce",
      "provider_action_id",
      "provider_post_id",
      "runtime_post_id"
    ],
    "eventLedger": {
      "appendOnly": true,
      "hashChained": true,
      "deriveCurrentStateFromHistory": true,
      "stateOverwriteAllowed": false,
      "missingEvidenceState": "UNKNOWN"
    },
    "negativeControls": [
      "premature_execution_denied",
      "expired_authority_rejected",
      "replayed_nonce_blocked",
      "mismatched_content_rejected"
    ],
    "redStates": [
      "DENIED",
      "EXPIRED",
      "REVOKED",
      "FAILED",
      "UNKNOWN",
      "CORRELATION_FAILED",
      "INGRESS_INVALID",
      "DUPLICATE_BLOCKED",
      "ROLLBACK_PENDING",
      "ROLLED_BACK"
    ],
    "releaseGate": {
      "requiresLiveProviderMutation": true,
      "requiresControlledSyntheticRun": true,
      "requiresExactReceiptCorrelation": true,
      "requiresVerifiedIngressCapability": true,
      "requiresAuthenticatedIngress": true,
      "requiresSignatureVerification": true,
      "requiresUnconsumedAuthority": true,
      "requiresLiveProviderCapability": true,
      "requiresCurrentContentHashMatch": true,
      "requiresRuntimeOutcomeObservation": true
    }
  },
  "activationGates": {
    "requiredSecrets": [
      "FOUNDER_SIGNAL_ENGINE_MCP_TOKEN",
      "ZAPIER_FOUNDER_SIGNAL_ENGINE_HOOK_URL",
      "FOUNDER_SIGNAL_AUTOMATION_GRANT_JSON"
    ],
    "requiredCapabilities": [
      "webhook_trigger",
      "multi_step_workflow_or_backend_orchestration",
      "instant_private_reply_ingress"
    ],
    "freeTwoStepZapAloneSufficient": false,
    "gmailPollingTriggerAcceptedForDeadlineCommands": false,
    "controlledSyntheticRunRequired": true,
    "exactReceiptCorrelationRequired": true
  }
}
