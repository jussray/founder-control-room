{
  "version": 3,
  "status": "implemented-awaiting-live-provider-and-ingress-proof",
  "provider": "buffer",
  "zapier": {
    "action": "buffer_add_to_queue",
    "requiredMethod": "schedule",
    "allowedMethods": [
      "schedule"
    ],
    "rejectedMethods": [
      "draft",
      "queue",
      "publish",
      "share_next",
      "share_now",
      "schedule_draft"
    ],
    "mappingComment": "method: schedule # exact live option and date-field mapping must be captured in the controlled Zap proof"
  },
  "api": {
    "mutation": "createPost",
    "required": {
      "sharingMode": "customScheduled",
      "dueAtSource": "scheduled_at",
      "saveToDraft": false
    }
  },
  "reviewWindow": {
    "minutes": 20,
    "startsFrom": "generated_at",
    "generatedAtMaximumAgeMinutes": 5,
    "fireTimeOwnedByFirewall": true,
    "noReplyBehavior": "publish_by_existing_buffer_schedule",
    "shareNowAllowed": false
  },
  "notification": {
    "provider": "gmail",
    "required": true,
    "mode": "one_campaign_digest_for_up_to_three_posts",
    "requiredFields": [
      "caption",
      "channel",
      "fire_time",
      "buffer_post_id",
      "review_token",
      "reply_context_id",
      "founder_sender",
      "reply_to",
      "gmail_thread_id"
    ],
    "failurePolicy": "cancel_scheduled_batch",
    "replyCommands": [
      "cancel all",
      "<channel>: cancel",
      "<channel>: <requested tweak>"
    ],
    "replyAuthorizationFields": [
      "founder_sender",
      "reply_to",
      "reply_context_id",
      "review_token",
      "review_deadline"
    ],
    "evidenceOnlyFields": [
      "gmail_thread_id"
    ],
    "replyIdentityPolicy": "exact_founder_sender_private_recipient_and_uuid_review_context",
    "replyParsingPolicy": "exactly_one_unquoted_command_on_first_nonempty_line",
    "quotedHistoryPolicy": "ignore_only_after_valid_command_boundary",
    "ambiguousReplyPolicy": "reject_multiple_unquoted_command_lines",
    "editPolicy": "regenerate_and_revalidate_before_buffer_update",
    "replyIngress": {
      "requiredLatencyClass": "instant_private_ingress",
      "gmailPollingAllowed": false,
      "preferredImplementation": "cloudflare_email_routing_worker",
      "replyToMode": "private_domain_address_bound_to_uuid_review_context",
      "reason": "a 15-minute polling trigger cannot reliably honor commands throughout a 20-minute review window"
    }
  },
  "authority": {
    "publishAllowed": true,
    "schedulePolicyId": "buffer-20-minute-review-v1",
    "requiredAuthorizationMode": "standing-policy",
    "standingGrantId": "founder-approved-auto-distribution-v1",
    "requiresRuntimeMintedCorrelation": true,
    "correlationFormat": "standing-policy:<grantId>:<invocationId>:<publicSignalHashPrefix>",
    "correlationPurpose": "context-bound standing-policy correlation only; not founder authentication",
    "authenticatedAuthorizationReceiptVerifiedAtFirewall": false,
    "securityBoundary": "this firewall validates exact content, source, evidence lineage, Current-You context, checked-in standing policy, and correlation; actor authentication, when required, must be enforced by trusted private ingress before this code runs",
    "publicSignalContextVersion": "fcr/public-signal-context@v1",
    "publicSignalPolicyVersion": "public-progress-v1",
    "requiresCurrentIntentHash": true,
    "requiresSourceContextHash": true,
    "requiresPrivateEvidenceHash": true,
    "requiresPositiveEvidenceCount": true,
    "maximumGrantIdLength": 100,
    "maximumReceiptLength": 240,
    "requiresExactSourceCommit": true,
    "requiresHttpsProof": false,
    "optionalPublicProofMustBeHttps": true,
    "liveProviderMutationIncluded": false
  },
  "activationGates": {
    "requiredSecrets": [
      "FOUNDER_SIGNAL_ENGINE_MCP_TOKEN",
      "ZAPIER_FOUNDER_SIGNAL_ENGINE_HOOK_URL",
      "FOUNDER_SIGNAL_AUTOMATION_GRANT_JSON"
    ],
    "requiredCapabilities": [
      "webhook_trigger",
      "multi_step_workflow_or_backend_orchestration",
      "instant_private_reply_ingress"
    ],
    "freeTwoStepZapAloneSufficient": false,
    "gmailPollingTriggerAcceptedForDeadlineCommands": false,
    "controlledSyntheticRunRequired": true,
    "exactReceiptCorrelationRequired": true,
    "privateIngressAuthenticationProofRequiredBeforeClaimingAuthenticatedFounderAuthority": true
  }
}
