{
  "version": 1,
  "plan": {
    "name": "Zapier Free",
    "monthly_task_limit": 100,
    "operating_ceiling": 90,
    "emergency_reserve": 10
  },
  "scope": {
    "reported_current_monthly_tasks": 126,
    "planned_monthly_tasks": 82,
    "headroom_below_operating_ceiling": 8,
    "overflow_behavior": "hold_in_zapier_table_for_manual_review_or_next_month"
  },
  "allocations": [
    {
      "id": "founder-signal-analysis",
      "monthly_runs": 30,
      "tasks_per_run": 2,
      "planned_tasks": 60,
      "billable_actions": [
        "one structured AI analysis",
        "one same-deal HubSpot result note"
      ]
    },
    {
      "id": "approved-linkedin-drafts",
      "monthly_runs": 10,
      "tasks_per_run": 1,
      "planned_tasks": 10,
      "billable_actions": [
        "one Buffer LinkedIn draft or queue item after founder approval"
      ]
    },
    {
      "id": "approved-investor-outreach",
      "monthly_runs": 8,
      "tasks_per_run": 1,
      "planned_tasks": 8,
      "billable_actions": [
        "one personalized email send after founder approval"
      ]
    },
    {
      "id": "failure-writeback",
      "monthly_runs": 4,
      "tasks_per_run": 1,
      "planned_tasks": 4,
      "billable_actions": [
        "one same-deal HubSpot failure task"
      ]
    }
  ],
  "analysis_output_contract": {
    "single_ai_action": true,
    "fields": [
      "signal_id",
      "decision",
      "who",
      "what",
      "where",
      "when",
      "why",
      "how",
      "verified_evidence",
      "inferred_conclusions",
      "unknown_information",
      "missing_evidence",
      "first_failure_stage",
      "recommended_next_action",
      "me_reality_now",
      "me_smallest_next_action",
      "me_founder_voice",
      "me_profile_angle",
      "future_you_guidance",
      "future_you_what_mattered",
      "future_you_what_did_not",
      "future_you_valid_fear",
      "chief_ai_decision",
      "linkedin_draft",
      "facebook_draft",
      "instagram_draft",
      "investor_outreach_draft",
      "publish_allowed"
    ],
    "future_you": {
      "time_horizon_years": 5,
      "voice": "first_person_future_self",
      "required_opener": "The thing you’re worried about most right now — I remember that. Here’s what actually happened…",
      "must_be_specific": true,
      "generic_advice_allowed": false
    },
    "me": {
      "meaning": "present-self founder decision layer",
      "must_name_reality_now": true,
      "must_choose_one_smallest_next_action": true,
      "must_preserve_founder_voice": true,
      "profile_angle_only_when_relevant": true
    }
  },
  "free_steps": [
    "triggers",
    "filters",
    "formatter",
    "paths",
    "delay",
    "looping",
    "sub-zaps",
    "digests",
    "zapier-manager",
    "storage",
    "tables",
    "forms"
  ],
  "guardrails": {
    "one_ai_call_per_signal": true,
    "social_channels_generated_in_one_ai_response": true,
    "future_you_and_me_share_core_ai_action": true,
    "buffer_linkedin_first": true,
    "other_social_channels_remain_review_drafts": true,
    "hubspot_result_note_is_canonical_writeback": true,
    "founder_control_room_reads_proof_without_a_second_zapier_write": true,
    "external_send_or_publish_requires_founder_approval": true,
    "budget_gate_runs_before_billable_actions": true,
    "stop_new_billable_work_at_operating_ceiling": true,
    "delete_or_disable_existing_zaps_automatically": false
  }
}
