/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'

/control-room/*
  Cache-Control: no-store

/demo/*
  Cache-Control: no-store

/.well-known/sekret-bip-control-room.json
  Access-Control-Allow-Origin: https://sekret-bip-audit.p9s5nbwqyt.chatgpt.site
  Cache-Control: no-store
  Vary: Origin
