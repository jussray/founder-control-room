    "GPTBot": "deny",
    "Claude-SearchBot": "allow_bounded_public_paths",
    "Claude-User": "allow_bounded_public_paths",
    "ClaudeBot": "deny",
    "Googlebot": "allow_bounded_public_paths",
    "Google-Extended": "deny"
  },
  "public_paths": [
    "/",
    "/juss-rayy/",
    "/work.html",
    "/guardrails",
    "/mom8/",
    "/robots.txt",
    "/sitemap.xml",
    "/llms.txt",
    "/crawlers.json"
  ],
  "public_truth": {
