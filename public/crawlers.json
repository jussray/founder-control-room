  "project": "founder-control-room",
  "canonical_origin": "https://www.foundercontrolroom.org",
  "policy": {
    "search_discovery": "allow_bounded_public_paths",
    "user_directed_retrieval": "allow_bounded_public_paths",
    "model_training": "deny",
